# 统一换行符：Windows 上 git 默认会把文本文件转成 CRLF，
# 而 shell 脚本带 CRLF 会在 Linux / Git Bash 里报
#   bad interpreter: /usr/bin/env bash^M
# 所以脚本与配置一律锁定 LF。
* text=auto

*.sh        text eol=lf
*.bash      text eol=lf
*.py        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf

# 二进制/凭据类不做任何转换
*.png       binary
*.jpg       binary
*.b64       binary
*.gz        binary
*.zip       binary
